\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Le Cam tightness across acceptance predicates. Empirical best-attacker accuracy tracks $1/2 + \mathrm  {TV}/2$ to within sampling noise. Multiple attacker classes (Bayes, logistic regression, 1-nearest-neighbor) tie; in the codomain $|Y| = 8$ the feature space saturates and all reasonable attackers collapse to per-value majority vote. This empirically realizes the Le Cam upper bound.}}{35}{table.206}\protected@file@percent }
\newlabel{tab:le-cam-tight}{{4}{35}{Le Cam tightness across acceptance predicates. Empirical best-attacker accuracy tracks $1/2 + \mathrm {TV}/2$ to within sampling noise. Multiple attacker classes (Bayes, logistic regression, 1-nearest-neighbor) tie; in the codomain $|Y| = 8$ the feature space saturates and all reasonable attackers collapse to per-value majority vote. This empirically realizes the Le Cam upper bound}{table.206}{}}
