% Cipher type over X (renders as the sans-serif C(X))
\newcommand{\cipher}[1]{\mathsf{C}(#1)}

% Orbit operator from the algebraic-cipher-types development
\newcommand{\orbitF}{\operatorname{orbit}_F}

% The entropy ratio (marginal-scale confidentiality measure)
